<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="splash"
            android:width="320dp"
            android:height="320dp"
            android:viewportWidth="320"
            android:viewportHeight="320">
            <group
                android:name="scaleme"
                android:pivotX="160"
                android:pivotY="160">
                <path
                    android:name="circle"
                    android:fillColor="@color/cg_background"
                    android:pathData="M0 160c0-88.37 71.63-160 160-160h0c88.37 0 160 71.63 160 160v0c0 88.37-71.63 160-160 160h0c-88.37 0-160-71.63-160-160z"
                    />
                <group
                    android:name="bird_group"
                    android:pivotX="160"
                    android:pivotY="160"
                    android:scaleX="0.5"
                    android:scaleY="0.5">
                    <item>
                        <bitmap
                            android:src="@drawable/cg_logo_bird"
                            android:gravity="center" />
                    </item>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="bird_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="@integer/splash_screen_duration"
                    android:valueFrom="0.0"
                    android:valueTo="0.6"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_extra_slow_in"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="@integer/splash_screen_duration"
                    android:valueFrom="0.0"
                    android:valueTo="0.6"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/fast_out_extra_slow_in"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
